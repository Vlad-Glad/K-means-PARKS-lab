<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CA2255;NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Parcs.Net" Version="10.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>

  <!-- Embed SixLabors.ImageSharp.dll inside Parcs.Modules.KMeansSegmentation.dll so the module
       remains a single standalone DLL for PARCS Host MetadataLoadContext & Daemon loading. -->
  <Target Name="EmbedImageSharp" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <EmbeddedResource Include="$(PkgSixLabors_ImageSharp)\lib\net6.0\SixLabors.ImageSharp.dll">
        <LogicalName>SixLabors.ImageSharp.dll</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
